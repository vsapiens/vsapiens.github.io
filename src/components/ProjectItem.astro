---
import StatusBadge from './StatusBadge.astro';
import { getLanguageColor, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const primaryLink = project.links.live || project.links.repo;
const hasLive = Boolean(project.links.live);
const hasRepo = Boolean(project.links.repo);
---

<article
  class="group relative bg-bg-elevated border border-white/5 rounded-lg p-5 flex flex-col h-full hover:border-accent-purple/30 hover:shadow-[0_0_20px_rgba(167,139,250,0.08)] hover:-translate-y-0.5 transition-all duration-300"
  data-category={project.category}
  data-status={project.status}
>
  <header class="flex items-start justify-between gap-3 mb-2">
    <h3 class="text-base font-semibold text-text-heading font-mono leading-snug pt-0.5">
      {project.name}
    </h3>
    <StatusBadge status={project.status} />
  </header>

  <p class="text-accent-purple text-sm font-medium mb-2">{project.tagline}</p>
  <p class="text-text-secondary text-sm leading-relaxed mb-4 flex-1">{project.description}</p>

  <div class="flex flex-wrap gap-1.5 mb-4">
    {project.tech.slice(0, 4).map((t) => (
      <span class="px-2 py-0.5 bg-bg-surface rounded text-[11px] text-text-secondary border border-white/5 font-mono">
        {t}
      </span>
    ))}
  </div>

  <footer class="flex items-center justify-between gap-3 pt-3 border-t border-white/5 mt-auto">
    <div class="flex items-center gap-3 min-w-0">
      {project.languages.slice(0, 2).map((lang) => (
        <span class="flex items-center gap-1.5 text-xs text-text-secondary whitespace-nowrap">
          <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background-color: ${getLanguageColor(lang)}`}></span>
          {lang}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-2.5 flex-shrink-0">
      {hasRepo && (
        <a href={project.links.repo} target="_blank" rel="noopener" class="text-text-secondary hover:text-accent-purple transition-colors" aria-label={`${project.name} source code`}>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" /></svg>
        </a>
      )}
      {hasLive && (
        <a href={project.links.live} target="_blank" rel="noopener" class="text-text-secondary hover:text-accent-purple transition-colors" aria-label={`${project.name} live site`}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      )}
      {!primaryLink && project.private && (
        <svg class="w-4 h-4 text-text-secondary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-label="Private repository"><title>Private repository</title><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
      )}
    </div>
  </footer>
</article>
