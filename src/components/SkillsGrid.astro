---
import { getLanguageColor } from '../lib/projects';

const languages = ['TypeScript', 'JavaScript', 'Python', 'Go', 'Java', 'C/C++', 'SQL', 'Swift'];

const toolCategories = [
  {
    title: 'Frameworks & Runtime',
    skills: ['Node.js', 'React', 'Next.js', 'NestJS', 'Express', 'Astro', 'Vue', 'FastAPI', 'Flask', 'LangChain'],
  },
  {
    title: 'Cloud & Infra',
    skills: ['AWS', 'GCP', 'Docker', 'Kubernetes', 'Vercel', 'Render', 'Turborepo', 'Caddy'],
  },
  {
    title: 'Data & Payments',
    skills: ['PostgreSQL', 'Supabase', 'Redis / Upstash', 'MongoDB', 'Neon', 'Drizzle', 'Stripe'],
  },
  {
    title: 'Performance & Observability',
    skills: ['k6', 'Locust', 'Grafana', 'Prometheus', 'New Relic', 'CloudWatch', 'Sentry', 'OpenTelemetry'],
  },
  {
    title: 'AI & LLMs',
    skills: ['Anthropic Claude', 'OpenAI', 'Gemini', 'Ollama', 'LangChain', 'Streamlit'],
  },
];
---

<section class="py-20 bg-bg-elevated/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold text-text-heading font-mono mb-2">
      <span class="text-accent-purple">~/</span>skills
    </h2>
    <div class="h-px bg-gradient-to-r from-accent-purple/50 to-transparent mb-8"></div>

    <!-- Languages: GitHub-style colored dots -->
    <div class="bg-bg-elevated border border-white/5 rounded-lg p-6 mb-6">
      <h3 class="text-sm font-mono text-accent-purple uppercase tracking-wider mb-4">Languages</h3>
      <div class="flex flex-wrap gap-2.5">
        {languages.map((lang) => (
          <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-bg-surface rounded-md text-sm text-text-primary border border-white/5 hover:border-accent-purple/30 hover:shadow-[0_0_10px_rgba(167,139,250,0.1)] transition-all font-mono">
            <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${getLanguageColor(lang)}`}></span>
            {lang}
          </span>
        ))}
      </div>
    </div>

    <!-- Tooling -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {toolCategories.map((category) => (
        <div class="bg-bg-elevated border border-white/5 rounded-lg p-6">
          <h3 class="text-sm font-mono text-accent-purple uppercase tracking-wider mb-4">
            {category.title}
          </h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span class="px-3 py-1.5 bg-bg-surface rounded-md text-sm text-text-primary border border-white/5 hover:border-accent-purple/30 hover:shadow-[0_0_10px_rgba(167,139,250,0.1)] transition-all font-mono">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
