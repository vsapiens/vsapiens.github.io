---
import type { Locale } from '../data/site';
import { contact } from '../data/site';
import { getLocalizedPath } from '../lib/quote';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = locale === 'es'
  ? { note: 'Ingeniería de sistemas con evidencia y dirección humana.', work: 'Trabajo', writing: 'Escritura', contact: 'Contacto' }
  : { note: 'Systems engineering with evidence and human direction.', work: 'Work', writing: 'Writing', contact: 'Contact' };
---

<footer class="site-footer">
  <div class="page-shell footer-grid">
    <div>
      <a href={getLocalizedPath('/', locale)} class="footer-name">Erick González</a>
      <p>{copy.note}</p>
    </div>
    <nav aria-label={locale === 'es' ? 'Pie de página' : 'Footer'}>
      <a href={getLocalizedPath('/work', locale)}>{copy.work}</a>
      <a href={getLocalizedPath('/blog', locale)}>{copy.writing}</a>
      <a href={getLocalizedPath('/contact', locale)}>{copy.contact}</a>
    </nav>
    <div class="footer-external">
      <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
    <p class="footer-year">© {new Date().getFullYear()} · Astro / GitHub Pages</p>
  </div>
</footer>
