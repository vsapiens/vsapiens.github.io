---
interface Props { label?: string; title: string; intro?: string; id?: string; }
const { label, title, intro, id } = Astro.props;
---

<header class="section-heading" id={id}>
  {label && <p class="section-label">{label}</p>}
  <h2>{title}</h2>
  {intro && <p class="section-intro">{intro}</p>}
</header>
