---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { marketing } from '../data/content';
import { contact } from '../data/site';
import type { Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = marketing[locale];
---
<BaseLayout title={copy.meta.contact[0]} description={copy.meta.contact[1]} locale={locale}>
  <PageHero title={copy.contact.title} intro={copy.contact.intro} marker={locale === 'es' ? 'CANAL / CONTACTO' : 'CHANNEL / CONTACT'} />
  <section class="content-section"><div class="page-shell contact-grid"><a class="contact-primary" href={`mailto:${contact.email}`}><span>01 / EMAIL</span><strong>{copy.contact.email}</strong><small>{contact.email}</small></a><a href={contact.linkedin} target="_blank" rel="noopener noreferrer"><span>02 / LINKEDIN</span><strong>{copy.contact.linkedin}</strong><small>linkedin.com/in/erickfgonzalez</small></a><a href={contact.github} target="_blank" rel="noopener noreferrer"><span>03 / GITHUB</span><strong>{copy.contact.github}</strong><small>github.com/vsapiens</small></a></div><p class="security-note">{copy.contact.note}</p></section>
</BaseLayout>
