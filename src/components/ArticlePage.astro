---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { marketing } from '../data/content';
import type { Locale } from '../data/site';
import { getLocalizedPath } from '../lib/quote';
import { formatPublicationDate } from '../lib/utils';

interface Props { locale: Locale; post: CollectionEntry<'blog'>; }
const { locale, post } = Astro.props;
const copy = marketing[locale];
const { Content } = await render(post);
const formattedDate = formatPublicationDate(post.data.date, locale);
const readTime = Math.ceil((post.body?.split(/\s+/).length ?? 0) / 200);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article" locale={locale}>
  <article class="page-shell article-shell">
    <header class="article-header">
      <a class="back-link" href={getLocalizedPath('/blog', locale)}>← {copy.blog.back}</a>
      <h1>{post.data.title}</h1>
      <div class="article-meta"><time datetime={post.data.date.toISOString()}>{formattedDate}</time><span>/</span><span>{readTime} {copy.blog.readTime}</span></div>
      <div class="tag-list">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
    </header>
    <div class="prose max-w-none article-prose"><Content /></div>
    <footer class="article-footer"><a class="button-link button-secondary" href={getLocalizedPath('/blog', locale)}>← {copy.blog.all}</a></footer>
  </article>
</BaseLayout>
