---
import { services, type Locale } from '../data/site';
import { serviceDetails, marketing } from '../data/content';
import { formatPrice, getLocalizedPath } from '../lib/quote';

interface Props { locale: Locale; compact?: boolean; }
const { locale, compact = false } = Astro.props;
const copy = marketing[locale].services;
const visible = compact ? services.slice(0, 3) : services;
---

<div class:list={['services-grid', compact && 'services-grid-compact']}>
  {visible.map((service, index) => {
    const detail = serviceDetails[service.id];
    return (
      <article class="service-card" id={service.id}>
        <div class="service-number">{String(index + 1).padStart(2, '0')}</div>
        <h3>{service.name[locale]}</h3>
        <p>{service.description[locale]}</p>
        {!compact && <><h4>{copy.fit}</h4><p>{detail.fit[locale]}</p><h4>{copy.includes}</h4><ul>{detail.includes[locale].map((item) => <li>{item}</li>)}</ul></>}
        <div class="service-price"><span>{copy.priceNote}</span><strong>{formatPrice(service.price, locale)}</strong></div>
        {!compact && <a class="text-link" href={`${getLocalizedPath('/contact', locale)}?service=${service.id}#quote`}>{copy.cta}<span aria-hidden="true">↗</span></a>}
      </article>
    );
  })}
</div>
