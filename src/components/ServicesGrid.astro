---
import { services, type Locale } from '../data/site';
import { serviceDetails, marketing } from '../data/content';
import { formatCreditClause, formatPrice, getLocalizedPath } from '../lib/quote';

interface Props { locale: Locale; compact?: boolean; }
const { locale, compact = false } = Astro.props;
const copy = marketing[locale].services;
const visible = compact ? services.slice(0, 3) : services;
const secondaryLocale: Locale = locale === 'en' ? 'es' : 'en';
---

<div class:list={['services-grid', compact && 'services-grid-compact']}>
  {visible.map((service, index) => {
    const detail = serviceDetails[service.id];
    const credit = formatCreditClause(service, locale);
    const quoteHref = `${getLocalizedPath('/contact', locale)}?service=${service.id}#quote`;
    return (
      <article class="service-card" id={service.id}>
        <div class="service-topline">
          <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="service-stamp">{copy.fixedPrice} · {service.duration[locale]}</span>
        </div>
        <h3>{service.name[locale]}</h3>
        <p>{service.description[locale]}</p>
        {!compact && (
          <>
            <h4>{copy.fit}</h4>
            <p>{detail.fit[locale]}</p>
            <h4>{copy.includes}</h4>
            <ol class="service-deliverables">{detail.includes[locale].map((item, itemIndex) => <li><span>{String(itemIndex + 1).padStart(2, '0')}</span>{item}</li>)}</ol>
          </>
        )}
        <div class="service-price-block">
          <span class="service-price-label">{copy.priceNote}</span>
          <strong class="service-price-primary">{formatPrice(service.price, locale)}</strong>
          <span class="service-price-secondary">{formatPrice(service.price, secondaryLocale)}</span>
        </div>
        {credit && <p class="service-credit">{credit}</p>}
        <a class="text-link service-cta" href={quoteHref}>{compact ? copy.quoteCta : copy.cta}<span aria-hidden="true">↗</span></a>
      </article>
    );
  })}
</div>
