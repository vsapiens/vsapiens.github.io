---
import experienceData from '../data/experience.json';
import type { Locale } from '../data/site';
import { experienceTranslations, formatExperienceDate } from '../data/experience-i18n';

interface Props { locale?: Locale; limit?: number; }
const { locale = 'en', limit } = Astro.props;
const jobs = typeof limit === 'number' ? experienceData.slice(0, limit) : experienceData;
---

<ol class="experience-list">
  {jobs.map((job, index) => {
    const localized = locale === 'es' ? experienceTranslations[job.company] : undefined;
    return (
      <li class="experience-entry">
        <div class="experience-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
        <div class="experience-content">
          <div class="experience-title-row"><div><h3>{localized?.role ?? job.role}</h3><p>{job.company}</p></div><time>{formatExperienceDate(job.startDate, locale)}—{formatExperienceDate(job.endDate, locale)}</time></div>
          <ul>{(localized?.description ?? job.description).map((item) => <li>{item}</li>)}</ul>
          <div class="tag-list">{job.tech.map((tech) => <span>{tech}</span>)}</div>
        </div>
      </li>
    );
  })}
</ol>
